##################################################################################
# VARIABLES
##################################################################################

variable "student_no" {
  type    = string
  default = "1"
}

variable "public_key" {
  type    = string
  default = "<your_ssh_public_key>"
}

variable "key_name" {
  type    = string
  default = "class_smsv2"
}

variable "extra_cidrs" {
  type    = string
  default = null
}

variable "vpc_id" {
  type    = string
  default = null
}
